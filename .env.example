# Copy to .env for local development. Never commit real values.
PORT=3000
NODE_ENV=development
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Server-only secret: never use in a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Push notifications (server only; VAPID_PRIVATE_KEY must never go in frontend code).
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-server-only-vapid-private-key
VAPID_SUBJECT=mailto:admin@fashionbazz.in
